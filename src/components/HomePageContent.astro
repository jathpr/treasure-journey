---
import { pathFor, translations, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<div class="intro">
  <h1>{t.homeGreeting}</h1>
  <p class="lead">{t.homeIntro}</p>
</div>

<nav class="home-actions" aria-label={t.homeNavigation}>
  <a class="home-action" href={pathFor(locale, "theory")}>{t.theory}</a>
  <a class="home-action" href={pathFor(locale, "practice")}>{t.practice}</a>
  <a class="home-action" href={pathFor(locale, "why")}>{t.why}</a>
</nav>
