---
import type { CollectionEntry } from "astro:content";
import JourneyPageContent from "../../components/JourneyPageContent.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getJourney, nodeIdFor } from "../../lib/journey";
import { translations } from "../../lib/i18n";

// These paths become static HTML files such as /journey/theory/index.html.
export async function getStaticPaths() {
  const journey = await getJourney("be");
  return journey
    .filter((entry) => nodeIdFor(entry) !== "home")
    .map((entry: CollectionEntry<"journey">) => ({
      params: { slug: nodeIdFor(entry) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const locale = "be";
const t = translations[locale];
---

<SiteLayout
  title={`${entry.data.title} — ${t.homeTitle}`}
  description={entry.data.summary}
  currentId={nodeIdFor(entry)}
  locale={locale}
>
  <JourneyPageContent entry={entry} locale={locale} />
</SiteLayout>
