---
import { getJourney, nodeIdFor } from "../lib/journey";
import { locales, pathFor, translations, type Locale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  currentId?: string;
  locale?: Locale;
}

const { title, description, currentId, locale = "be" } = Astro.props;
const t = translations[locale];
const journey = await getJourney(locale);
const home = journey.find((entry) => nodeIdFor(entry) === "home");
// The home node's outgoing edges supply the visible navigation links.
const navEntries =
  home?.data.linksTo
    .map((nodeId) => journey.find((entry) => nodeIdFor(entry) === nodeId))
    .filter((entry) => entry !== undefined) ?? [];
const navStops = navEntries.map((entry, index) => {
  const progress = navEntries.length === 1 ? 0.5 : index / (navEntries.length - 1);
  const x = 10 + progress * 64;
  const curveProgress = x / 100;
  const y = (1 - (240 / 220) * curveProgress * (1 - curveProgress)) * 100;
  const tangent = Math.atan(((-240 + 480 * curveProgress) * 190) / (220 * 1000));
  const angle = (tangent * 180) / Math.PI;
  return { entry, index, x, y, angle };
});
const menuProgress = 0.91;
const menuY = (1 - (240 / 220) * menuProgress * (1 - menuProgress)) * 100;
const menuAngle =
  (Math.atan(((-240 + 480 * menuProgress) * 190) / (220 * 1000)) * 180) / Math.PI;
---

<!doctype html>
<html lang={t.languageCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101315" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site">
      <svg class="sky-field" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="sky-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#dce9e5" />
            <stop offset="100%" stop-color="#c5d9d9" />
          </linearGradient>
        </defs>
        <path d="M0 0H1000V220Q500 100 0 220Z" />
      </svg>

      <a class="moon corner" href={pathFor(locale, "home")} aria-label={t.homeLabel}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle class="moon-disc" cx="32" cy="32" r="27" />
        </svg>
      </a>

      <details class="corner-gatha" open>
        <summary aria-label={t.gathaLabel}>
          <svg class="gatha-constellation" viewBox="0 0 48 48" aria-hidden="true">
            <polygon class="constellation-star" points="9,4 10.5,8.5 15,10 10.5,11.5 9,16 7.5,11.5 3,10 7.5,8.5" />
            <polygon class="constellation-star" points="24,16 25.5,20.5 30,22 25.5,23.5 24,28 22.5,23.5 18,22 22.5,20.5" />
            <polygon class="constellation-star" points="39,28 40.5,32.5 45,34 40.5,35.5 39,40 37.5,35.5 33,34 37.5,32.5" />
          </svg>
          <span class="visually-hidden">{t.gathaLabel}</span>
          <span class="gatha-copy">{t.gatha}</span>
        </summary>
      </details>

      <nav class="wheel-nav" aria-label={t.navigation}>
        <ol>
          <svg class="wheel-arc" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 220Q500 100 1000 220" />
          </svg>
          {navStops.map(({ entry, index, x, y, angle }) => (
            <li
              class="curve-stop node-stop"
              data-node-stop
              data-curve-stop
              data-node-index={index}
              style={`--stop-x: ${x}%; --stop-y: ${y}%; --stop-angle: ${angle}deg;`}
            >
              <a
                href={pathFor(locale, nodeIdFor(entry))}
                aria-current={nodeIdFor(entry) === currentId ? "page" : undefined}
                class:list={{ "wheel-stop": true, "is-current": nodeIdFor(entry) === currentId }}
              >
                {entry.data.title}
              </a>
            </li>
          ))}
          <li
            class="curve-stop menu-stop"
            data-curve-stop
            style={`--stop-x: ${menuProgress * 100}%; --stop-y: ${menuY}%; --stop-angle: ${menuAngle}deg;`}
          >
            <details class="wheel-menu">
              <summary aria-label={t.menuLabel}>
                <svg class="menu-arrow" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M17 10H4m0 0 6-6M4 10l6 6" />
                </svg>
              </summary>
              <div class="menu-content">
                <span class="menu-label">{t.language}</span>
                <nav aria-label={t.language}>
                  {locales.map((targetLocale) => (
                    <a
                      href={pathFor(targetLocale, currentId)}
                      lang={translations[targetLocale].languageCode}
                      aria-current={targetLocale === locale ? "page" : undefined}
                      class:list={{
                        "language-link": true,
                        "is-current": targetLocale === locale,
                      }}
                    >
                      {t.languageNames[targetLocale]}
                    </a>
                  ))}
                </nav>
              </div>
            </details>
          </li>
        </ol>
      </nav>

      <main id="main-content" class="reading-panel" tabindex="0">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  function alignStopsToArc() {
    const arc = document.querySelector<SVGSVGElement>(".wheel-arc");
    if (!arc) return;

    const { width, height } = arc.getBoundingClientRect();
    if (!width || !height) return;

    const nodeStops = [...document.querySelectorAll<HTMLElement>("[data-node-stop]")];
    const isMobile = window.matchMedia("(max-width: 720px)").matches;

    nodeStops.forEach((stop) => {
      const index = Number.parseInt(stop.dataset.nodeIndex ?? "0", 10);
      const progress = nodeStops.length === 1 ? 0.5 : index / (nodeStops.length - 1);
      const x = isMobile ? 14 + progress * 52 : 10 + progress * 64;
      stop.style.setProperty("--stop-x", `${x}%`);
    });

    const menuStop = document.querySelector<HTMLElement>(".menu-stop");
    if (menuStop) {
      menuStop.style.setProperty("--stop-x", `${isMobile ? 88 : 91}%`);
    }

    document.querySelectorAll<HTMLElement>("[data-curve-stop]").forEach((stop) => {
      const x = Number.parseFloat(stop.style.getPropertyValue("--stop-x")) / 100;
      stop.style.setProperty(
        "--stop-y",
        `${(1 - (240 / 220) * x * (1 - x)) * 100}%`,
      );
      const slope = ((-240 + 480 * x) * height) / (220 * width);
      stop.style.setProperty("--stop-angle", `${(Math.atan(slope) * 180) / Math.PI}deg`);
    });
  }

  alignStopsToArc();
  window.addEventListener("resize", alignStopsToArc);
</script>

<style>
  .site {
    position: relative;
    width: min(1180px, calc(100% - 64px));
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    margin: 0 auto;
    isolation: isolate;
  }

  .sky-field {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: var(--sky-height);
    overflow: visible;
    filter: drop-shadow(0 1px 1px rgb(41 59 61 / 38%));
    transform: translateX(-50%);
    pointer-events: none;
  }

  .sky-field path {
    fill: url("#sky-gradient");
  }

  .corner {
    position: absolute;
    z-index: 2;
    color: var(--sky-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .moon {
    top: 4vh;
    left: 2px;
    display: grid;
    width: 100px;
    height: 100px;
    place-items: center;
  }

  .moon svg {
    width: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 20px rgb(213 189 131 / 18%));
  }

  .moon-disc {
    fill: #fffdf5;
  }

  .corner-gatha {
    position: absolute;
    z-index: 2;
    top: 4vh;
    right: 54px;
    max-width: min(260px, calc(100% - 200px));
    color: var(--sky-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .corner-gatha summary {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    cursor: pointer;
    list-style: none;
  }

  .corner-gatha summary::-webkit-details-marker,
  .wheel-menu summary::-webkit-details-marker {
    display: none;
  }

  .gatha-constellation {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    overflow: visible;
    fill: #fff0bd;
    filter: drop-shadow(0 0 5px rgb(255 240 189 / 48%));
  }

  .constellation-star {
    stroke: none;
  }

  .gatha-copy {
    display: none;
    max-width: 230px;
    color: var(--sky-text);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .corner-gatha[open] .gatha-constellation {
    display: none;
  }

  .corner-gatha[open] .gatha-copy {
    display: block;
  }

  .site:has(.wheel-menu[open]) .corner-gatha {
    opacity: 0;
    visibility: hidden;
  }

  .wheel-nav {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: var(--sky-height);
    overflow: visible;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .wheel-nav ol {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wheel-arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translateY(var(--nav-curve-offset));
    pointer-events: none;
  }

  .wheel-arc path {
    fill: none;
    stroke: rgb(165 166 158 / 42%);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .curve-stop {
    position: absolute;
    z-index: 1;
    top: var(--stop-y);
    left: var(--stop-x);
    transform: translate(-50%, calc(-50% + var(--nav-curve-offset))) rotate(var(--stop-angle));
    pointer-events: auto;
  }

  .wheel-stop {
    display: grid;
    width: clamp(104px, 12vw, 148px);
    min-height: 48px;
    place-items: center;
    padding: 7px 10px;
    border: 1px solid rgb(165 166 158 / 55%);
    border-radius: 3px;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.3;
    text-align: center;
    box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4px rgb(165 166 158 / 24%);
    transition: border-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }

  .wheel-stop:hover,
  .wheel-stop.is-current {
    border-color: var(--accent);
    color: var(--text);
    box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4px rgb(213 189 131 / 42%);
  }

  .reading-panel {
    position: absolute;
    top: calc(var(--sky-height) + 74px);
    bottom: 13%;
    left: 50%;
    width: min(76%, 820px);
    overflow: auto;
    padding: 18px 24px 28px;
    overscroll-behavior: contain;
    scrollbar-color: #59605a transparent;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    transform: translateX(-50%);
  }

  :global(.reading-panel h1),
  :global(.reading-panel h2),
  :global(.reading-panel p) {
    margin-top: 0;
  }

  :global(.reading-panel h1) {
    margin-bottom: 16px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }

  :global(.lead) {
    max-width: 680px;
    color: #c5c4bb;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .wheel-menu summary {
    display: grid;
    width: 64px;
    min-height: 48px;
    place-items: center;
    border: 1px solid rgb(165 166 158 / 55%);
    border-radius: 3px;
    background: var(--bg);
    color: var(--sky-text);
    cursor: pointer;
    list-style: none;
    box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4px rgb(165 166 158 / 24%);
  }

  .wheel-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-arrow {
    width: 24px;
    height: 24px;
    overflow: visible;
    fill: none;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .wheel-menu[open] .menu-arrow {
    transform: rotate(180deg);
  }

  .menu-content {
    position: absolute;
    top: 50%;
    right: calc(100% + 10px);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    background: #171b1c;
    box-shadow: 0 12px 32px rgb(0 0 0 / 24%);
    opacity: 0;
    pointer-events: none;
    transform: translate(18px, -50%) rotate(14deg);
    transform-origin: 100% 50%;
    transition:
      opacity 180ms ease,
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 180ms;
    visibility: hidden;
    white-space: nowrap;
  }

  .wheel-menu[open] .menu-content {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%) rotate(0);
    visibility: visible;
  }

  .menu-label {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .menu-content nav {
    display: flex;
    gap: 4px;
  }

  .language-link {
    padding: 5px 8px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--text);
  }

  .language-link:hover,
  .language-link.is-current {
    border-color: rgb(213 189 131 / 50%);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    :global(:root) {
      --sky-height: clamp(150px, 27vh, 190px);
      --nav-curve-offset: 24px;
    }

    .site {
      width: calc(100% - 32px);
      min-height: 680px;
      max-height: none;
    }

    .moon {
      top: 20px;
      width: 84px;
      height: 84px;
    }

    .corner-gatha {
      top: 20px;
      right: 50px;
      max-width: min(240px, calc(100% - 150px));
    }

    .corner-gatha summary {
      min-height: 42px;
    }

    .gatha-constellation {
      width: 32px;
      height: 32px;
    }

    .corner-gatha[open] .gatha-copy {
      max-width: min(220px, 65vw);
      font-size: 0.84rem;
    }

    .wheel-stop {
      width: clamp(62px, 20vw, 78px);
      min-height: 40px;
      padding: 5px 4px;
      font-size: 0.69rem;
    }

    .wheel-menu summary {
      width: 44px;
      min-height: 40px;
    }

    .reading-panel {
      top: calc(var(--sky-height) + 74px);
      right: 0;
      bottom: 76px;
      left: 0;
      width: 100%;
      padding: 14px 14px 24px;
      transform: none;
    }

    :global(.reading-panel h1) {
      font-size: clamp(2rem, 9vw, 2.8rem);
    }

    :global(.lead) {
      font-size: 1rem;
    }

    .menu-content {
      top: calc(100% + 8px);
      right: 0;
      gap: 8px;
      padding: 7px;
      transform: translate(0, -8px) rotate(8deg);
      transform-origin: 100% 0;
    }

    .wheel-menu[open] .menu-content {
      transform: translate(0) rotate(0);
    }

    .menu-content nav {
      gap: 2px;
    }

    .language-link {
      padding: 5px 6px;
      font-size: 0.82rem;
    }
  }
</style>
