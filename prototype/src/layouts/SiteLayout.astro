---
import { getJourney, nodeIdFor } from "../lib/journey";
import { locales, pathFor, translations, type Locale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  currentId?: string;
  locale?: Locale;
}

const { title, description, currentId, locale = "be" } = Astro.props;
const t = translations[locale];
const journey = await getJourney(locale);
const home = journey.find((entry) => nodeIdFor(entry) === "home");
// The home node's outgoing edges supply the visible navigation links.
const navEntries =
  home?.data.linksTo
    .map((nodeId) => journey.find((entry) => nodeIdFor(entry) === nodeId))
    .filter((entry) => entry !== undefined) ?? [];
const navStops = navEntries.map((entry, index) => {
  const progress = navEntries.length === 1 ? 0.5 : index / (navEntries.length - 1);
  const x = 12 + progress * 76;
  const distanceFromCenter = (x / 100 - 0.5) * 2;
  const y = (1 - (120 / 220) * (1 - distanceFromCenter ** 2)) * 100;
  return { entry, x, y };
});
---

<!doctype html>
<html lang={t.languageCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101315" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site">
      <svg class="sky-field" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="sky-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#dce9e5" />
            <stop offset="100%" stop-color="#c5d9d9" />
          </linearGradient>
        </defs>
        <path d="M0 0H1000V220Q500 100 0 220Z" />
      </svg>

      <a class="moon corner" href={pathFor(locale, "home")} aria-label={t.homeLabel}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle class="moon-disc" cx="32" cy="32" r="27" />
        </svg>
      </a>

      <details class="corner-gatha" open>
        <summary aria-label={t.gathaLabel}>
          <svg class="gatha-constellation" viewBox="0 0 48 48" aria-hidden="true">
            <polygon class="constellation-star" points="9,4 10.5,8.5 15,10 10.5,11.5 9,16 7.5,11.5 3,10 7.5,8.5" />
            <polygon class="constellation-star" points="24,16 25.5,20.5 30,22 25.5,23.5 24,28 22.5,23.5 18,22 22.5,20.5" />
            <polygon class="constellation-star" points="39,28 40.5,32.5 45,34 40.5,35.5 39,40 37.5,35.5 33,34 37.5,32.5" />
          </svg>
          <span class="visually-hidden">{t.gathaLabel}</span>
          <span class="gatha-copy">{t.gatha}</span>
        </summary>
      </details>

      <nav class="wheel-nav" aria-label={t.navigation}>
        <ol>
          <svg class="wheel-arc" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 220Q500 100 1000 220" />
          </svg>
          {navStops.map(({ entry, x, y }) => (
            <li style={`--stop-x: ${x}%; --stop-y: ${y}%;`}>
              <a
                href={pathFor(locale, nodeIdFor(entry))}
                aria-current={nodeIdFor(entry) === currentId ? "page" : undefined}
                class:list={{ "wheel-stop": true, "is-current": nodeIdFor(entry) === currentId }}
              >
                {entry.data.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <main id="main-content" class="reading-panel" tabindex="0">
        <slot />
      </main>

      <aside class="corner-map" aria-label={t.map}>
        <span>{t.map}</span>
        <span class="map-status">{t.later}</span>
      </aside>

      <details class="corner-menu">
        <summary aria-label={t.menuLabel}>
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>
        <div class="menu-content">
          <span class="menu-label">{t.language}</span>
          <nav aria-label={t.language}>
            {locales.map((targetLocale) => (
              <a
                href={pathFor(targetLocale, currentId)}
                lang={translations[targetLocale].languageCode}
                aria-current={targetLocale === locale ? "page" : undefined}
                class:list={{ "language-link": true, "is-current": targetLocale === locale }}
              >
                {t.languageNames[targetLocale]}
              </a>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </body>
</html>

<style>
  .site {
    position: relative;
    width: min(1180px, calc(100% - 64px));
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    margin: 0 auto;
    isolation: isolate;
  }

  .sky-field {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: var(--sky-height);
    overflow: visible;
    filter: drop-shadow(0 1px 1px rgb(41 59 61 / 38%));
    transform: translateX(-50%);
    pointer-events: none;
  }

  .sky-field path {
    fill: url("#sky-gradient");
  }

  .corner {
    position: absolute;
    z-index: 2;
    color: var(--sky-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .moon {
    top: 4vh;
    left: 2px;
    display: grid;
    width: 100px;
    height: 100px;
    place-items: center;
  }

  .moon svg {
    width: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 20px rgb(213 189 131 / 18%));
  }

  .moon-disc {
    fill: #fffdf5;
  }

  .corner-gatha {
    position: absolute;
    z-index: 2;
    top: 4vh;
    right: 54px;
    max-width: min(260px, calc(100% - 200px));
    color: var(--sky-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .corner-gatha summary {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    cursor: pointer;
    list-style: none;
  }

  .corner-gatha summary::-webkit-details-marker,
  .corner-menu summary::-webkit-details-marker {
    display: none;
  }

  .gatha-constellation {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    overflow: visible;
    fill: #fff0bd;
    filter: drop-shadow(0 0 5px rgb(255 240 189 / 48%));
  }

  .constellation-star {
    stroke: none;
  }

  .gatha-copy {
    display: none;
    max-width: 230px;
    color: var(--sky-text);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .corner-gatha[open] .gatha-constellation {
    display: none;
  }

  .corner-gatha[open] .gatha-copy {
    display: block;
  }

  .wheel-nav {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: var(--sky-height);
    overflow: visible;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .wheel-nav ol {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wheel-arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translateY(var(--nav-curve-offset));
    pointer-events: none;
  }

  .wheel-arc path {
    fill: none;
    stroke: rgb(165 166 158 / 42%);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .wheel-nav li {
    position: absolute;
    top: var(--stop-y);
    left: var(--stop-x);
    transform: translate(-50%, calc(-50% + var(--nav-curve-offset)));
    pointer-events: auto;
  }

  .wheel-stop {
    display: block;
    width: clamp(86px, 13vw, 150px);
    padding: 6px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.3;
    text-align: center;
    transition: color 160ms ease;
  }

  .wheel-stop:hover,
  .wheel-stop.is-current {
    color: var(--text);
  }

  .reading-panel {
    position: absolute;
    top: calc(var(--sky-height) + 74px);
    bottom: 13%;
    left: 50%;
    width: min(76%, 820px);
    overflow: auto;
    padding: 18px 24px 28px;
    overscroll-behavior: contain;
    scrollbar-color: #59605a transparent;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    transform: translateX(-50%);
  }

  .corner-map {
    position: absolute;
    z-index: 2;
    right: 2px;
    bottom: 4vh;
    display: grid;
    gap: 2px;
    color: var(--sky-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
    text-align: right;
  }

  .map-status {
    color: var(--muted);
    font-size: 0.68rem;
  }

  :global(.reading-panel h1),
  :global(.reading-panel h2),
  :global(.reading-panel p) {
    margin-top: 0;
  }

  :global(.reading-panel h1) {
    margin-bottom: 16px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }

  :global(.lead) {
    max-width: 680px;
    color: #c5c4bb;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .corner-menu {
    position: absolute;
    z-index: 3;
    top: 4vh;
    right: 0;
    color: var(--sky-text);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .corner-menu summary {
    display: grid;
    width: 42px;
    height: 50px;
    place-items: center;
    cursor: pointer;
    list-style: none;
  }

  .corner-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: grid;
    width: 22px;
    gap: 5px;
  }

  .menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--sky-text);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .corner-menu[open] .menu-icon span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .corner-menu[open] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .corner-menu[open] .menu-icon span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-content {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    min-width: 176px;
    gap: 7px;
    padding: 12px;
    border: 1px solid var(--line);
    background: #171b1c;
    box-shadow: 0 12px 32px rgb(0 0 0 / 24%);
  }

  .menu-label {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .menu-content nav {
    display: grid;
    gap: 3px;
  }

  .language-link {
    padding: 5px 7px;
    color: var(--text);
  }

  .language-link:hover,
  .language-link.is-current {
    background: #242a29;
    color: var(--accent);
  }

  @media (max-width: 720px) {
    :global(:root) {
      --sky-height: clamp(150px, 27vh, 190px);
      --nav-curve-offset: 24px;
    }

    .site {
      width: calc(100% - 32px);
      min-height: 680px;
      max-height: none;
    }

    .wheel-nav {
      top: var(--sky-height);
      left: 0;
      width: calc(100vw - 24px);
      height: 62px;
      overflow-x: auto;
      overflow-y: hidden;
      transform: none;
      pointer-events: auto;
      scrollbar-width: none;
    }

    .wheel-nav::-webkit-scrollbar {
      display: none;
    }

    .wheel-nav ol {
      position: relative;
      inset: auto;
      display: flex;
      width: max-content;
      min-width: 100%;
      height: 100%;
      align-items: center;
      gap: 10px;
      padding: 0 8px;
    }

    .wheel-arc {
      display: none;
    }

    .wheel-nav li {
      position: static;
      transform: none;
    }

    .moon {
      top: 20px;
      width: 84px;
      height: 84px;
    }

    .corner-gatha {
      top: 20px;
      right: 50px;
      max-width: min(240px, calc(100% - 150px));
    }

    .corner-gatha summary {
      min-height: 42px;
    }

    .gatha-constellation {
      width: 32px;
      height: 32px;
    }

    .corner-gatha[open] .gatha-copy {
      max-width: min(220px, 65vw);
      font-size: 0.84rem;
    }

    .wheel-stop {
      width: 100px;
      font-size: 0.75rem;
    }

    .reading-panel {
      top: calc(var(--sky-height) + 74px);
      right: 0;
      bottom: 76px;
      left: 0;
      width: 100%;
      padding: 14px 14px 24px;
      transform: none;
    }

    :global(.reading-panel h1) {
      font-size: clamp(2rem, 9vw, 2.8rem);
    }

    :global(.lead) {
      font-size: 1rem;
    }

    .corner-menu {
      top: 20px;
      right: 0;
    }

    .corner-map {
      right: 0;
      bottom: 14px;
    }
  }
</style>
